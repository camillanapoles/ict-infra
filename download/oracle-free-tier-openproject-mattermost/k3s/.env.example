# =============================================================================
# K3S - Variáveis de Ambiente - OpenProject + Mattermost
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o .env real no repositório Git!
# cp .env.example .env
# =============================================================================

# ---- DOMÍNIO ----
# Domínio principal (ex: seudominio.com)
DOMAIN_NAME=seudominio.com

# Subdomínios para cada aplicação
OPENPROJECT_SUBDOMAIN=projects
MATTERMOST_SUBDOMAIN=chat

# URLs completas (derivadas)
# OPENPROJECT_FQDN=projects.seudominio.com
# MATTERMOST_FQDN=chat.seudominio.com

# ---- CLOUDFLARE DNS ----
# API Token para Let's Encrypt DNS-01 challenge e DNS gerenciado
# Obtido em: Cloudflare Dashboard > My Profile > API Tokens
# Permissões: Zone:DNS:Edit
CLOUDFLARE_API_TOKEN=CHANGE_ME_CLOUDFLARE_API_TOKEN
CLOUDFLARE_EMAIL=admin@seudominio.com

# ---- POSTGRESQL ----
# Senha do superusuário PostgreSQL
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
# Senha do usuário OpenProject no banco
OPENPROJECT_DB_PASSWORD=CHANGE_ME_OPENPROJECT_DB_PASSWORD
# Senha do usuário Mattermost no banco
MATTERMOST_DB_PASSWORD=CHANGE_ME_MATTERMOST_DB_PASSWORD

# ---- OPENPROJECT ----
# Chave secreta (gerar: openssl rand -hex 64)
OPENPROJECT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHARS
# Senha do administrador
OPENPROJECT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
OPENPROJECT_ADMIN_EMAIL=admin@seudominio.com

# ---- MATTERMOST ----
MATTERMOST_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
MATTERMOST_ADMIN_EMAIL=admin@seudominio.com

# ---- SMTP ----
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USER=noreply@seudominio.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# ---- BACKUP ----
BACKUP_RETENTION_DAYS=30
