# =============================================================================
# ORACLE CLOUD FREE TIER - OPENPROJECT + MATTERMOST
# Variáveis de Ambiente - IaC End-to-End
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o .env real no repositório Git!
# cp .env.example .env
# =============================================================================

# ---- ORACLE CLOUD (OCI) AUTHENTICATION ----
# Obtido em: OCI Console > Profile > API Keys
# OU via: oci setup config
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxx
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxx
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:11:22:33:44:55:66:77:88:99:00
OCI_PRIVATE_KEY_PATH=~/.oci/oci_api_key.pem
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaaaaaaxxxxxxxxxxxxxxxx
OCI_REGION=sa-saopaulo-1

# ---- OCI SSH KEY ----
# Gerar: ssh-keygen -t rsa -b 4096 -C "oracle-deploy" -f ~/.ssh/oracle_deploy
SSH_PUBLIC_KEY=ssh-rsa AAAAB3NzaC1yc2EAAAA... oracle-deploy
SSH_PRIVATE_KEY_PATH=~/.ssh/oracle_deploy

# ---- DOMÍNIOS ----
# Configure os domínios/subdomínios apontando para o IP público da VM
# No seu provedor DNS, crie registros A:
#   projects.seudominio.com  -> IP_DA_VM
#   chat.seudominio.com      -> IP_DA_VM
OPENPROJECT_DOMAIN=projects.seudominio.com
MATTERMOST_DOMAIN=chat.seudominio.com

# ---- SSL / CERTIFICADOS ----
# Email para Let's Encrypt (obrigatório, recebe notificações de expiração)
CERTBOT_EMAIL=admin@seudominio.com

# ---- BANCO DE DADOS (PostgreSQL 17 Compartilhado) ----
# Senha do superusuário PostgreSQL
# Gerar: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM_32_CHARS

# ---- OPENPROJECT ----
# Chave secreta do OpenProject (para sessões/cookies)
# Gerar: openssl rand -hex 64
OPENPROJECT_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHARS
# Senha do administrador OpenProject
OPENPROJECT_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Email do administrador
OPENPROJECT_ADMIN_EMAIL=admin@seudominio.com

# ---- MATTERMOST ----
# Senha do administrador Mattermost
MATTERMOST_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Email do administrador
MATTERMOST_ADMIN_EMAIL=admin@seudominio.com
# Token JWT para WebSocket
# Gerar: openssl rand -base64 64 | tr -d '\n'
MATTERMOST_SITE_URL=https://chat.seudominio.com

# ---- SMTP (Email / Notificações) ----
# Usar OCI Email Delivery (Always Free: 3.000 emails/mês)
# OU qualquer SMTP externo (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USER=noreply@seudominio.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@seudominio.com
SMTP_TLS=true

# ---- OCI VAULT (Secrets Manager - Always Free) ----
# Se habilitado, os secrets do banco/senhas são armazenados no OCI Vault
ENABLE_VAULT=true
VAULT_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaaaaaaxxxxxxxxxxxxxxxx

# ---- OCI MONITORING ----
# Monitoring IDs (preenchidos automaticamente pelo Terraform outputs)
# OCID_MONITING_COMPARTMENT=
# OCID_LOG_GROUP=
# OCID_NOTIFICATION_TOPIC=

# ---- OCI OBJECT STORAGE (Backups - Always Free: 20 GB) ----
# Namespace do Object Storage para backups
# Obtido em: OCI Console > Object Storage > Namespace
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_BACKUP_BUCKET_NAME=incubadora-backups

# ---- OCI LOAD BALANCER (Always Free: 10 Mbps) ----
# Se false, usa apenas Nginx reverse proxy na VM
ENABLE_LOAD_BALANCER=false
ENABLE_WAF=false

# ---- COMPUTE ----
VM_SHAPE=VM.Standard.A1.Flex
VM_OCPUS=4
VM_MEMORY_GB=24
BOOT_VOLUME_GB=50
BLOCK_VOLUME_GB=150

# ---- REDE ----
VCN_CIDR=10.0.0.0/16
SUBNET_PUBLIC_CIDR=10.0.1.0/24

# ---- GITHUB SECRETS (preenchidos no GitHub repo Settings > Secrets) ----
# TF_VAR_tenancy_ocid
# TF_VAR_user_ocid
# TF_VAR_fingerprint
# TF_VAR_private_key (conteúdo PEM completo)
# TF_VAR_compartment_ocid
# TF_VAR_region
# TF_VAR_ssh_public_key
# TF_VAR_admin_password
# VM_SSH_PRIVATE_KEY (chave privada para acesso via SSH)
# OPENPROJECT_DOMAIN
# MATTERMOST_DOMAIN

# ---- AMBIENTE ----
ENVIRONMENT=production
DEPLOYMENT_TIMESTAMP=auto-generated

# ---- BACKUP ----
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/opt/backups
