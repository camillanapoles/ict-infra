# =============================================================================
# Variáveis de ambiente - Oracle Cloud Free Tier
# OpenProject + Mattermost
# =============================================================================
# Copie este arquivo para .env e preencha com seus dados:
#   cp .env.example .env
#   vim .env
# =============================================================================

# --- Geral ---
# Chave secreta para o OpenProject (gerar com: openssl rand -hex 64)
OPENPROJECT_SECRET_KEY=gerar_com_openssl_rand_hex_64

# Senha do PostgreSQL (gerar com: openssl rand -hex 32)
# IMPORTANTE: Use uma senha forte! Esta será usada para ambos os bancos.
POSTGRES_PASSWORD=gerar_com_openssl_rand_hex_32

# --- Domínios (substitua pelos seus domínios reais apontados para a VM) ---
OPENPROJECT_DOMAIN=openproject.exemplo.com
MATTERMOST_DOMAIN=mattermost.exemplo.com

# --- Email / SMTP (necessário para envio de convites e notificações) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_DOMAIN=gmail.com
SMTP_AUTH=login

# Email do OpenProject (configuração específica)
OPENPROJECT_EMAIL_METHOD=smtp
OPENPROJECT_FROM_ADDRESS=openproject@exemplo.com

# Mattermost SMTP toggle
MM_ENABLE_SMTP=true

# --- Oracle Cloud Infrastructure (opcional - para OCI Monitoring) ---
# Preencha apenas se quiser usar o agente de monitoramento do OCI
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxxx
OCI_INSTANCE_ID=ocid1.instance.oc1.phx.xxxxx
OCI_TENANT_ID=ocid1.tenancy.oc1..xxxxx
